# --- SMTP Office 365 ---
# Important : Microsoft désactive SMTP AUTH par défaut sur les tenants récents.
# Activez-le pour la boîte concernée via Exchange Admin Center
# (Utilisateurs actifs > Mail > Gérer les applications e-mail > SMTP authentifié).
# Si le compte a la MFA activée, générez un mot de passe d'application.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=haramainprestige@outlook.com
SMTP_PASS=votre_mot_de_passe_ou_app_password

# --- Expéditeur affiché ---
SMTP_FROM=haramainprestige@outlook.com
SMTP_FROM_NAME="Haramain Prestige"

# --- Destinataire des demandes ---
MAIL_TO=contact@nidemiel.com
MAIL_TO_NAME="Haramain Prestige"

# --- Origines autorisées (CORS), séparées par des virgules ---
ALLOWED_ORIGINS=http://localhost:5173,https://haramain-prestige.fr

# --- Rate limiting ---
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600

# --- Contact WhatsApp affiché dans l'email (bouton "Répondre sur WhatsApp") ---
# Facultatif : si le visiteur n'a pas laissé son numéro (nouvelle demande),
# le bouton pointe vers ce fallback. Sinon on prend celui du formulaire.
WHATSAPP_FALLBACK=33773157902
