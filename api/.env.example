# --- SMTP (fournisseur email du domaine) ---
# Renseigner les identifiants fournis par le prestataire SMTP réellement
# configuré pour contact@haramainprestige.com. Les valeurs ci-dessous
# reflètent la configuration courante mais peuvent évoluer avec le
# fournisseur choisi (host, port, mode d'authentification, éventuel
# app password requis).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=contact@haramainprestige.com
SMTP_PASS=your_mailbox_password

# --- Expéditeur affiché ---
SMTP_FROM=contact@haramainprestige.com
SMTP_FROM_NAME="Haramain Prestige"

# --- Destinataire des demandes ---
MAIL_TO=contact@haramainprestige.com
MAIL_TO_NAME="Haramain Prestige"

# --- Origines autorisées (CORS), séparées par des virgules ---
ALLOWED_ORIGINS=http://localhost:5173,https://haramainprestige.com

# --- Rate limiting ---
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600

# --- Reverse proxies de confiance (IP/CIDR, séparés par virgules) ---
# À RENSEIGNER SUR LE SERVEUR AVANT OUVERTURE DU TRAFIC PUBLIC.
#
# X-Forwarded-For n'est pris en compte QUE si REMOTE_ADDR correspond à
# une entrée ci-dessous. Vide = X-Forwarded-For entièrement ignoré → PHP
# verra l'IP du reverse proxy pour tous les visiteurs et le rate limiter
# regroupera l'intégralité du trafic sur une seule clé (les visiteurs
# légitimes seront bloqués dès que la limite globale est atteinte).
#
# La valeur doit correspondre au proxy RÉELLEMENT vu par PHP dans son
# REMOTE_ADDR. À déterminer sur le VPS, APRÈS déploiement, avec la
# topologie Docker réelle (le subnet du bridge dépend de la config de
# l'hôte, ne pas le deviner à l'avance) :
#   docker network inspect bridge \
#     --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# puis autoriser ce subnet, par ex. TRUSTED_PROXIES=<subnet-affiché>
#
# INTERDIT : 0.0.0.0/0, ::/0 ou toute plage globale — cela rendrait
# X-Forwarded-For trivialement spoofable par n'importe quel client.
TRUSTED_PROXIES=

# --- Contact WhatsApp affiché dans l'email (bouton "Répondre sur WhatsApp") ---
# Facultatif : si le visiteur n'a pas laissé son numéro (nouvelle demande),
# le bouton pointe vers ce fallback. Sinon on prend celui du formulaire.
WHATSAPP_FALLBACK=33773157902

# --- Debug SMTP (à laisser vide/0 en production) ---
# Mettre à 1 uniquement pour diagnostiquer un problème d'authentification
# ou de connexion SMTP. Écrit le dialogue SMTP dans les logs Apache/PHP
# (peut exposer nom d'utilisateur SMTP). NE JAMAIS activer en production
# normale.
SMTP_DEBUG=0
