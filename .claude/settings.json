{
    "permissions": {
        "allow": [
            "Bash(npm run lint)",
            "Bash(npm run typecheck)",
            "Bash(npm run test)",
            "Bash(npm run build)",
            "Bash(npm run quality)",
            "Bash(composer validate:*)",
            "Bash(php bin/console lint:*)",
            "Bash(php bin/console doctrine:schema:validate:*)",
            "Bash(vendor/bin/phpunit:*)",
            "Bash(docker compose ps:*)",
            "Bash(docker compose logs:*)",
            "Bash(curl -s http://localhost:*)"
        ],
        "deny": [
            "Read(./.env*)",
            "Bash(rm -rf:*)",
            "Bash(docker compose down -v:*)"
        ]
    },
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.sh\""
                    }
                ]
            }
        ]
    }
}